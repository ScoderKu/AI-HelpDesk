# MySQL
MYSQL_DATABASE=ai_helpdesk
MYSQL_USER=helpdesk_app
MYSQL_PASSWORD=ChangeThisLocalDbPassword
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword

# Backend security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Keep true for HTTPS deployments; set false only for local HTTP development.
AUTH_COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API and sign out.
FRONTEND_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Set only the exact IP addresses of trusted reverse proxies.
TRUSTED_PROXY_IPS=